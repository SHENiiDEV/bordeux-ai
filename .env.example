COMPANY_ADDRESS="Dept 6193 43 Owston Road, Carcroft, Doncaster, DN6 8DA"
COMPANY_EMAIL="info@bordeux.co.uk"
COMPANY_TAX_ID="Company No. 15954666"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

